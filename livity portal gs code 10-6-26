/**
 * Send a notification of a given type to a recipient.
 * typeKey: e.g. 'ENROLL_SUBMITTED' (must exist in NotificationTypes sheet)
 * recipient: { id, email } — id is PlayerID/CoachID/etc for the Notifications log
 * data: object used to fill {{placeholders}} in the DefaultTemplate
 */
function sendNotification_(typeKey, recipient, data) {
  const typeRow = findRowById_(SHEETS.NOTIFICATION_TYPES.name, typeKey);
  if (!typeRow) {
    logAudit_('NOTIF_UNKNOWN_TYPE', 'Unknown TypeKey: ' + typeKey, null);
    return null;
  }

  const label = typeRow[1];
  const audience = typeRow[2];
  const channel = typeRow[4];
  const template = typeRow[5];
  const body = renderTemplate_(template, data || {});

  const id = nextId_('NOTIF', SHEETS.NOTIFICATIONS.name);
  sheet_(SHEETS.NOTIFICATIONS.name).appendRow([
    id, typeKey, audience, (recipient && recipient.id) || '', label, body, channel, 'Unread', new Date(), ''
  ]);

  if ((channel === 'Email' || channel === 'Both') && recipient && recipient.email) {
    try {
      MailApp.sendEmail(recipient.email, label, body);
    } catch (mailErr) {
      logAudit_('NOTIF_EMAIL_FAILED', id + ' — ' + mailErr, null);
    }
  }

  return id;
}

/** Replaces {{key}} placeholders in a template string with values from data. */
function renderTemplate_(template, data) {
  return String(template).replace(/{{(\w+)}}/g, function (match, key) {
    const val = data[key];
    return (val !== undefined && val !== null) ? val : '';
  });
}

