function fmtTime_(v) {
  if (v instanceof Date) return Utilities.formatDate(v, getTargetSs_().getSpreadsheetTimeZone(), 'HH:mm');
  return String(v == null ? '' : v);
}
/** Active players enrolled in programId: Players.ProgramID match OR Active, unexpired package na may natitirang sessions sa program na yon. */
function getProgramRosterRows_(programId) {
  const now = new Date();
  const pricing = sheet_(SHEETS.PRICING.name).getDataRange().getValues();
  const programOfPrice = {};
  for (let i = 1; i < pricing.length; i++) programOfPrice[pricing[i][0]] = pricing[i][1];

  const players = sheet_(SHEETS.PLAYERS.name).getDataRange().getValues();
  const byId = {}, out = [], seen = {};
  for (let i = 1; i < players.length; i++) {
    const r = players[i];
    if (String(r[9] || 'Active').trim().toLowerCase() !== 'active') continue;
    byId[r[0]] = r;
    if (r[7] === programId) { seen[r[0]] = true; out.push(r); }
  }

  const pkgs = sheet_(SHEETS.PACKAGES.name).getDataRange().getValues();
  for (let i = 1; i < pkgs.length; i++) {
    const r = pkgs[i];
    if (r[7] !== 'Active' || r[2] === 'PRC-MEMB') continue;
    if (programOfPrice[r[2]] !== programId) continue;
    if (r[6] && now > new Date(r[6])) continue;
    if (Number(r[5]) >= Number(r[4])) continue;
    const p = byId[r[1]];
    if (!p || seen[p[0]]) continue;
    seen[p[0]] = true;
    out.push(p);
  }
  return out;
}

/** Sino ang inaasahan sa isang session. Private = booked lang (Registered rows sa Attendance); ibang program = package-based roster. */
function getSessionRecipients_(scheduleId, programId, date) {
  if (programId !== 'PRG-PRIV') return getProgramRosterRows_(programId);

  const tz = Session.getScriptTimeZone();
  const dateKey = Utilities.formatDate(date, tz, 'yyyy-MM-dd');
  const players = sheet_(SHEETS.PLAYERS.name).getDataRange().getValues();
  const byId = {};
  for (let i = 1; i < players.length; i++) {
    if (String(players[i][9] || 'Active').trim().toLowerCase() === 'active') byId[players[i][0]] = players[i];
  }
  const att = sheet_(SHEETS.ATTENDANCE.name).getDataRange().getValues();
  const out = [], seen = {};
  for (let i = 1; i < att.length; i++) {
    const r = att[i];
    if (r[2] !== scheduleId || !r[3] || r[4] !== 'Registered') continue;
    if (Utilities.formatDate(new Date(r[3]), tz, 'yyyy-MM-dd') !== dateKey) continue;
    const p = byId[r[1]];
    if (p && !seen[p[0]]) { seen[p[0]] = true; out.push(p); }
  }
  return out;
}

/** Menu: Livity Admin → Book Private Session. Gumagawa ng Registered row para ma-remind at ma-sweep as Absent kapag di sumipot. */
function bookPrivateSessionPrompt_() {
  const ui = SpreadsheetApp.getUi();
  const pRes = ui.prompt('Book Private Session', 'PlayerID (e.g. LVTFA-XXXXXXX):', ui.ButtonSet.OK_CANCEL);
  if (pRes.getSelectedButton() !== ui.Button.OK) return;
  const playerId = pRes.getResponseText().trim().toUpperCase();
  const playerRow = findRowById_(SHEETS.PLAYERS.name, playerId);
  if (!playerRow) { ui.alert('PlayerID not found: ' + playerId); return; }

  const sRes = ui.prompt('Book Private Session', 'ScheduleID ng Private slot (e.g. SCH-002):', ui.ButtonSet.OK_CANCEL);
  if (sRes.getSelectedButton() !== ui.Button.OK) return;
  const scheduleId = sRes.getResponseText().trim();
  const sched = findRowById_(SHEETS.SCHEDULE.name, scheduleId);
  if (!sched || sched[1] !== 'PRG-PRIV') { ui.alert('Hindi Private slot ang ScheduleID na yan.'); return; }

  const dRes = ui.prompt('Book Private Session', 'Petsa (yyyy-MM-dd):', ui.ButtonSet.OK_CANCEL);
  if (dRes.getSelectedButton() !== ui.Button.OK) return;
  const tz = Session.getScriptTimeZone();
  let date;
  try { date = Utilities.parseDate(dRes.getResponseText().trim(), tz, 'yyyy-MM-dd'); }
  catch (e) { ui.alert('Invalid date. Gamitin ang yyyy-MM-dd.'); return; }
  const dayName = Utilities.formatDate(date, tz, 'EEEE');
  if (dayName !== sched[2]) { ui.alert('Ang petsang yan ay ' + dayName + ', pero ang slot ay tuwing ' + sched[2] + '.'); return; }

  if (!playerHasRemainingSessions_(playerId, 'PRG-PRIV') &&
      ui.alert('Walang Private sessions na natitira', 'I-book pa rin?', ui.ButtonSet.YES_NO) !== ui.Button.YES) return;

  const attId = registerForSession(playerId, scheduleId, date);
  logAudit_('PRIVATE_BOOKED', attId + ' — ' + playerId + ' ' + scheduleId + ' ' + Utilities.formatDate(date, tz, 'yyyy-MM-dd'), null);
  try {
    sendNotification_('SCHEDULE_CONFIRMED', { id: playerId, email: playerRow[6] }, {
      playerName: playerRow[1],
      scheduleDetails: 'Private · ' + Utilities.formatDate(date, tz, 'EEEE, MMM d') + ' ' + fmtTime_(sched[3]) + ' · ' + sched[5]
    });
  } catch (e) { logAudit_('SYS_GAS_ERROR', 'Private booking notify failed: ' + e, null); }
  ui.alert('Booked: ' + playerRow[1] + ' (' + attId + ')');
}
