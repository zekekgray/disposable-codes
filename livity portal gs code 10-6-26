/**
 * Resolves what an EXISTING player is buying, by program — separate from resolvePriceId_
 * (which is only for brand-new enrollment). Regular uses the Top-Up rate, not the first-package
 * rate; Academy reuses the same package catalog since renewing is just another package purchase.
 */
function resolveTopupPriceId_(programId, category, packageKey) {
  if (programId === 'PRG-REG') {
    if (packageKey === 'single') return SINGLE_PRICE_MAP[category] || null;
    return TOPUP_PRICE_MAP[category] || null;
  }
  if (programId === 'PRG-ADV')  return 'PRC-ADV';
  if (programId === 'PRG-ACAD') return PROGRAM_PACKAGE_MAP[packageKey] || null;
  if (programId === 'PRG-PRIV') return PRIVATE_PACK_MAP[packageKey] || null;
  return null;
}

/** Single source of truth for Academy package price/sessions — reads live from the Pricing sheet. */
function getAcademyPackagesData_() {
  const packages = {};
  Object.keys(PROGRAM_PACKAGE_MAP).forEach(function (key) {
    const row = findRowById_(SHEETS.PRICING.name, PROGRAM_PACKAGE_MAP[key]);
    if (row) {
      packages[key] = { priceId: row[0], sessions: Number(row[4]), price: Number(row[5]), validityDays: Number(row[6]) };
    }
  });
  const membershipRow = findRowById_(SHEETS.PRICING.name, 'PRC-MEMB');
  const privatePacks = {};
  Object.keys(PRIVATE_PACK_MAP).forEach(function (key) {
    const row = findRowById_(SHEETS.PRICING.name, PRIVATE_PACK_MAP[key]);
    if (row && Number(row[5]) > 0) privatePacks[key] = { priceId: row[0], sessions: Number(row[4]), price: Number(row[5]), validityDays: Number(row[6]) };
  });
  return {
    success: true,
    packages: packages,
    privatePacks: privatePacks,
    membershipFee: membershipRow ? Number(membershipRow[5]) : 4000
  };
}

