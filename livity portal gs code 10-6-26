};

const PRIVATE_PACK_MAP = { private4: 'PRC-PRIV4', private8: 'PRC-PRIV8' };

const SINGLE_PRICE_MAP = {
  'U5-U7':  'PRC-U57S',
  'U9-U13': 'PRC-U913S',
