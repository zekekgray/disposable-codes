/** "2.3.0" → [2,3,0] */
function parseVer_(s) {
  const m = /^(\d+)\.(\d+)\.(\d+)$/.exec(String(s || '').trim());
  return m ? [Number(m[1]), Number(m[2]), Number(m[3])] : null;
}

/** Pinakamataas na version sa sheet (maliban sa row na ine-edit) → +1 minor; kapag lampas sa limit → +1 major. */
function nextVersion_(sh, exceptRow) {
  const per = Number(getConfigValue_('VersionMinorsPerMajor')) || 7;
  const data = sh.getDataRange().getValues();
  let best = null;
  for (let i = 1; i < data.length; i++) {
    if (i + 1 === exceptRow) continue;
    const v = parseVer_(data[i][1]);
    if (!v) continue;
    if (!best || v[0] > best[0] || (v[0] === best[0] && v[1] > best[1])) best = v;
  }
  if (!best) return '2.1.0';
  let major = best[0], minor = best[1] + 1;
  if (minor > per) { major += 1; minor = 0; }
  return major + '.' + minor + '.0';
}

/** Simple trigger — walang kailangang i-install. */
function onEdit(e) {
  try {
    if (!e || !e.range) return;
    const sh = e.range.getSheet();
    if (sh.getName() !== SHEETS.VERSIONS.name) return;
    if (e.range.getColumn() > 1) return; // message column lang (A)
    const tz = Session.getScriptTimeZone();
    const start = Math.max(2, e.range.getRow()), end = e.range.getLastRow();
    for (let r = start; r <= end; r++) {
      const msg = String(sh.getRange(r, 1).getValue() || '').trim();
      const ver = String(sh.getRange(r, 2).getValue() || '').trim();
      if (!msg || ver) continue; // walang message, o na-version na — huwag galawin
      const now = new Date();
      sh.getRange(r, 2, 1, 3).setNumberFormat('@');
      sh.getRange(r, 2, 1, 3).setValues([[nextVersion_(sh, r), Utilities.formatDate(now, tz, 'yyyyMMdd.HHmm'), Utilities.formatDate(now, tz, 'yyyy-MM-dd HH:mm:ss')]]);
    }
  } catch (err) { /* hindi dapat mag-error ang pag-edit ng sheet */ }
}

function getVersionData_() {
  const sh = sheet_(SHEETS.VERSIONS.name);
  if (!sh) return { success: true, current: null, history: [] };
  const data = sh.getDataRange().getValues();
  const items = [];
  for (let i = 1; i < data.length; i++) {
    if (!parseVer_(data[i][1])) continue;
    items.push({ version: String(data[i][1]).trim(), build: String(data[i][2] || '').trim(), whatsNew: String(data[i][0] || ''), timestamp: String(data[i][3] || '') });
  }
  return { success: true, current: items.length ? items[items.length - 1] : null, history: items.slice(-10).reverse() };
}
