function handleSavePhoto_(body) {
  const a = authPlayerRow_(body.playerId, body.contact);
  if (a.error) return { success: false, error: a.error };

  const image = String(body.image || '');
  if (image.length > 200000) return { success: false, error: 'Photo is too large.' };
  const m = /^data:image\/(jpeg|png);base64,(.+)$/.exec(image);
  if (!m) return { success: false, error: 'Invalid image.' };

  if (a.sheet.getRange(1, PHOTO_COL).getValue() !== 'PhotoURL') a.sheet.getRange(1, PHOTO_COL).setValue('PhotoURL');
  trashOldPhoto_(a.oldUrl);

  const blob = Utilities.newBlob(Utilities.base64Decode(m[2]), 'image/' + m[1], body.playerId + '.' + (m[1] === 'png' ? 'png' : 'jpg'));
  const file = getPhotoFolder_().createFile(blob);
  file.setSharing(DriveApp.Access.ANYONE_WITH_LINK, DriveApp.Permission.VIEW);
  const url = 'https://drive.google.com/thumbnail?id=' + file.getId() + '&sz=w320';

  a.sheet.getRange(a.rowIndex, PHOTO_COL).setValue(url);
  logAudit_('PLAYER_PHOTO_SAVED', body.playerId, null);
  return { success: true, photoUrl: url };
}

function handleRemovePhoto_(body) {
