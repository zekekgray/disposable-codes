/** Part 2 — find tomorrow's scheduled sessions and remind every active player on that program. */
function sendTomorrowSessionReminders_() {
  const DAY_NAMES = ['Sunday','Monday','Tuesday','Wednesday','Thursday','Friday','Saturday'];
  const tomorrow = new Date();
  tomorrow.setDate(tomorrow.getDate() + 1);
  const tomorrowName = DAY_NAMES[tomorrow.getDay()];

  const scheduleData = sheet_(SHEETS.SCHEDULE.name).getDataRange().getValues();
  const tomorrowSessions = scheduleData.slice(1).filter(function (r) { return r[2] === tomorrowName; });
