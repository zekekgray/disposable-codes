/**
 * Purchase a package for a player. Looks up Pricing to fill sessions/price/expiry.
 * Top-Up packages (PackageType === 'Top-Up') are only allowed while the player still has
 * an Active package with remaining sessions on the SAME program — this enforces the
 * "Top-Up available while sessions remain" rule shown in the pricing screen.
 */
const MIXED_SPLIT_ = {
  'PRC-ACADMA': { academy: 4, private: 4 },
  'PRC-ACADMB': { academy: 8, private: 4 },
  'PRC-ACADMC': { academy: 4, private: 8 }
};

function purchasePackage(playerId, priceId) {
  const pricingRow = findRowById_(SHEETS.PRICING.name, priceId);
  if (!pricingRow) throw new Error('Unknown PriceID: ' + priceId);

  const programId = pricingRow[1], packageType = pricingRow[3];
  if (packageType === 'Top-Up' && !playerHasRemainingSessions_(playerId, programId)) {
    throw new Error('Top-Up is only available while the player still has sessions remaining on an active package.');
  }

  const split = MIXED_SPLIT_[priceId] || null;
  // Academy purchases (and their membership / private companion) start Pending — activated when payment is verified
  const initialStatus_ = (programId === 'PRG-ACAD') ? 'Pending' : 'Active';
  const sessions = split ? split.academy : pricingRow[4];
  const purchaseDate = new Date();

  const id = nextId_('PKG', SHEETS.PACKAGES.name);
  const sh = sheet_(SHEETS.PACKAGES.name);
  sh.appendRow([id, playerId, priceId, purchaseDate, sessions, 0, '', initialStatus_]);

  // Mixed → companion Private package. ID = main + "P" so it shares the main payment status.
  if (split && split.private > 0) {
    sh.appendRow([id + 'P', playerId, 'PRC-PRIVPK', purchaseDate, split.private, 0, '', initialStatus_]);
  }

  logAudit_('PURCHASE_PACKAGE', id + ' for ' + playerId + ' (' + priceId + ')' + (split ? ' + private ' + split.private : ''), null);
  return id;
}

/** True if playerId has at least one Active package for programId with SessionsUsed < SessionsTotal. */
function playerHasRemainingSessions_(playerId, programId) {
  const pkgData = sheet_(SHEETS.PACKAGES.name).getDataRange().getValues();
  for (let i = 1; i < pkgData.length; i++) {
    const row = pkgData[i];
    if (row[1] !== playerId || row[7] !== 'Active') continue;
    const priceRow = findRowById_(SHEETS.PRICING.name, row[2]);
    if (!priceRow || priceRow[1] !== programId) continue;
    if (row[6] && new Date() > new Date(row[6])) continue;
    if (Number(row[5]) < Number(row[4])) return true;
  }
  return false;
}

