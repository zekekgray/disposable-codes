/** True if this exact Action was already logged recently — dedupe guard so a rung fires once per occurrence. */
function hasAuditAction_(action) {
  const data = sheet_(SHEETS.AUDITLOG.name).getDataRange().getValues();
  for (let i = data.length - 1; i >= 1 && i > data.length - 1000; i--) {
