      startTime: fmtTime_(row[3]),

      endTime: fmtTime_(row[4]),
      venue: row[5],
      notes: row[6]
    });
  }

  const week = WEEK_DAYS_ORDER_.map(function (day) {
    return { day: day, active: byDay[day].length > 0, sessions: byDay[day] };
  });

  return { success: true, week: week, generatedAt: new Date().toISOString() };
}

function handleEnrollment_(body) {
  const player = body.player || {};
  const guardian = body.guardian || {};
  const enrollment = body.enrollment || {};

  const missing = [];
  if (!player.firstName) missing.push('firstName');
  if (!player.lastName) missing.push('lastName');
  if (!player.gender) missing.push('gender');
  if (!guardian.guardianName) missing.push('guardianName');
  if (!guardian.whatsapp) missing.push('whatsapp');
  if (!enrollment.programId) missing.push('programId');
  const consentOk_ = [enrollment.consentPrivacy, enrollment.consent, enrollment.consents, body.consentPrivacy].some(function (v) {
    return v === true || v === 1 || String(v).toLowerCase() === 'true' || (v && typeof v === 'object' && Object.keys(v).length > 0);
  });
  if (!consentOk_) missing.push('consents');
  if (missing.length) {
    return { success: false, error: 'Missing required fields: ' + missing.join(', ') };
  }

  // Duplicate guard: same WhatsApp + same player name = already registered (siblings with different names are allowed)
  {
    const wantName = (String(player.firstName).trim() + ' ' + String(player.lastName).trim()).toLowerCase().replace(/\s+/g, ' ');
    const wantPhone = normPhone_(guardian.whatsapp);
    const existingPlayers = sheet_(SHEETS.PLAYERS.name).getDataRange().getValues();
    for (let i = 1; i < existingPlayers.length; i++) {
      const r = existingPlayers[i];
      if (normPhone_(r[5]) !== wantPhone) continue;
      if (String(r[1]).trim().toLowerCase().replace(/\s+/g, ' ') === wantName) {
        return { success: false, error: r[1] + ' is already registered under this number (Player ID: ' + r[0] + '). Use "Find My Player" to top up or add a program instead.' };
      }
    }
  }

  // Price is resolved server-side — never trust a price sent from the client.
  const priceId = resolvePriceId_(enrollment.programId, enrollment.packageKey, enrollment.category);
  let pricingRow = null;
  if (priceId) {
    pricingRow = findRowById_(SHEETS.PRICING.name, priceId);
    if (!pricingRow) {
      return { success: false, error: 'Unknown PriceID resolved: ' + priceId };
    }
  }
  // Private training has no fixed catalog price (priceId is null) — that's expected, not an error.
  if (!priceId && enrollment.programId !== 'PRG-PRIV') {
    return { success: false, error: 'Could not resolve a valid package for this program/category.' };
  }

  const playerId = registerPlayer({
    fullName: player.firstName + ' ' + player.lastName,
    birthYear: player.dob ? new Date(player.dob).getFullYear()
      : (player.age ? (new Date().getFullYear() - Number(player.age)) : ''),
    category: enrollment.category || '',
    guardianName: guardian.guardianName,
    contactNumber: guardian.whatsapp,
    email: guardian.email || '',
    programId: enrollment.programId,
    referredBy: enrollment.referredBy || ''
  });

  let packageId = null;
  let membershipPackageId = null;
  let totalPrice = 0;

  if (pricingRow) {
    packageId = purchasePackage(playerId, priceId);
    totalPrice = Number(pricingRow[5]);
  }

  // Membership fee — ONLY for Academy, added automatically, never for other programs.
  if (enrollment.programId === 'PRG-ACAD') {
    if (!playerHasMembership_(playerId)) {
      membershipPackageId = purchasePackage(playerId, 'PRC-MEMB');
      totalPrice += membershipFee_();
    }
  }

  // === START: PAYMENT STATE — SUBMISSIONS START PENDING, NOT PAID ===
 const paymentId = totalPrice > 0 ? recordPayment(playerId, packageId || 'PENDING', totalPrice, enrollment.paymentMethod || 'Unspecified', 'Pending') : null;
  // === END: PAYMENT STATE ===

  logAudit_('WEB_ENROLLMENT', playerId + ' via web form — ' + (priceId || 'no-fixed-price'), null);

  // Notify parent + admin
  sendNotification_('ENROLL_SUBMITTED', { id: playerId, email: guardian.email }, {
    guardianName: guardian.guardianName,
    playerName: player.firstName + ' ' + player.lastName,
    programName: lbProgramLabelServer_(enrollment.programId)
  });

  sendNotification_('ADMIN_NEW_ENROLLMENT', { email: getConfigValue_('AdminEmail') }, {
    playerName: player.firstName + ' ' + player.lastName,
    programName: lbProgramLabelServer_(enrollment.programId)
  });

  return {
    success: true,
    enrollmentId: playerId,
    packageId: packageId,
    paymentId: paymentId,
    amountDue: totalPrice
  };
}

function lbProgramLabelServer_(id) {
  const map = { 'PRG-REG':'Specialized Training — Regular', 'PRG-PRIV':'Specialized Training — Private', 'PRG-ADV':'Advanced Performance', 'PRG-ACAD':'Academy Training' };
  return map[id] || id;
}

function resolvePriceId_(programId, packageKey, category) {
  if (programId === 'PRG-ACAD') return PROGRAM_PACKAGE_MAP[packageKey] || null;
  if (programId === 'PRG-ADV')  return 'PRC-ADV';
  if (programId === 'PRG-REG') {
    const map = { 'U5-U7': 'PRC-U57', 'U9-U13': 'PRC-U913', 'U15+': 'PRC-U15' };
    return map[category] || null;
  }
  return null; // PRG-PRIV — rate confirmed by coach, not in the price catalog
}

