function getScheduleData_() {
  const scheduleData = sheet_(SHEETS.SCHEDULE.name).getDataRange().getValues();
  const programsData = sheet_(SHEETS.PROGRAMS.name).getDataRange().getValues();

  const programNames = {};
  for (let i = 1; i < programsData.length; i++) {
    programNames[programsData[i][0]] = programsData[i][1];
  }

  const byDay = {};
  WEEK_DAYS_ORDER_.forEach(function (d) { byDay[d] = []; });

  for (let i = 1; i < scheduleData.length; i++) {
    const row = scheduleData[i];
    const day = row[2];
