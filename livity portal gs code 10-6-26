/** verifiedAmount optional — if given and less than the payment's Amount, marks partial (stays Pending, notifies both sides) instead of full Paid. */
function verifyPayment_(paymentId, verifiedAmount) {
  const sheet = sheet_(SHEETS.PAYMENTS.name);
  const data = sheet.getDataRange().getValues();
  for (let i = 1; i < data.length; i++) {
    if (data[i][0] !== paymentId) continue;
    const playerId = data[i][1], amount = Number(data[i][3]);
    const playerRow = findRowById_(SHEETS.PLAYERS.name, playerId);
    const guardianEmail = playerRow ? playerRow[6] : '';
    const playerName = playerRow ? playerRow[1] : playerId;
    const vAmt = (verifiedAmount === undefined || verifiedAmount === null || verifiedAmount === '') ? amount : Number(verifiedAmount);

    if (vAmt < amount) {
      const remaining = amount - vAmt;
      sendNotification_('PAY_PARTIAL_VERIFIED', { id: playerId, email: guardianEmail }, { amount: vAmt, playerName: playerName, remaining: remaining });
      logAudit_('PAYMENT_PARTIAL_VERIFIED', paymentId + ' — ' + playerName + ' ₱' + vAmt + ' of ₱' + amount, null);
      return true;
    }

    sheet.getRange(i + 1, 7).setValue('Paid'); // Status
    activatePackagesForPayment_(playerId, data[i][2]);
    sendNotification_('PAY_VERIFIED', { id: playerId, email: guardianEmail }, { amount: amount, playerName: playerName });
    logAudit_('PAYMENT_VERIFIED', paymentId + ' — ' + playerName + ' ₱' + amount, null);
    return true;
  }
  return false;
}

