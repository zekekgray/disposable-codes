function getPenaltyRule_() {
  return {
    flat: Number(getConfigValue_('OverduePenaltyAmount')) || 0,
    perDay: Number(getConfigValue_('OverduePenaltyPerDay')) || 0,
    graceMinutes: Number(getConfigValue_('PenaltyGraceMinutes')) || 0,
    deadlineHours: Number(getConfigValue_('PaymentDeadlineHours')) || 12
  };
}

/** DueAt column (I); kapag wala (lumang rows) = DateTime + PaymentDeadlineHours. */
function paymentDueAt_(row, rule) {
  if (row[8]) { const d = new Date(row[8]); if (!isNaN(d.getTime())) return d; }
  return new Date(new Date(row[5]).getTime() + rule.deadlineHours * 3600000);
}

/** Hanggang anong oras tumatakbo ang orasan: SubmittedAt kung meron (frozen); Paid/Submitted na walang timestamp = walang penalty; kung hindi, NGAYON. */
function paymentEndAt_(row, now) {
  if (row[11]) { const s = new Date(row[11]); if (!isNaN(s.getTime())) return s; }
  if (row[6] === 'Paid' || row[6] === 'Submitted') return null;
  return now;
}

function penaltyFor_(dueAt, endAt, rule) {
  if (!endAt) return { amount: 0, overdueMs: 0 };
  const overMs = endAt.getTime() - dueAt.getTime();
  if (overMs - rule.graceMinutes * 60000 <= 0) return { amount: 0, overdueMs: 0 };
  const extraDays = rule.perDay > 0 ? Math.floor(overMs / 86400000) : 0;
  return { amount: rule.flat + rule.perDay * extraDays, overdueMs: overMs };
}

