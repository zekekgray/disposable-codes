/** Tumatanggap ng full URL ("?lvt=LVTFA-XXXXXXX&t=TOKEN"), "LVTFA-XXXXXXX.TOKEN", o bare "LVTFA-XXXXXXX" (manual entry). Tugma sa actual player ID format ng nextPlayerId_(). */
function parseScanCode_(code) {
  const s = String(code || '').trim();
  const lvtParam = /[?&]lvt=([^&]+)/i.exec(s);
  const idSource = lvtParam ? decodeURIComponent(lvtParam[1]) : s;
  const idMatch = /LVTFA-[A-Z0-9]{7}/i.exec(idSource);
  if (!idMatch) return null;
  const playerId = idMatch[0].toUpperCase();
  const tParam = /[?&]t=([A-Za-z0-9]+)/.exec(s);
  const tDot = /\.([A-Za-z0-9]+)\s*$/.exec(idSource);
  const token = tParam ? tParam[1] : (tDot ? tDot[1] : '');
  return { playerId: playerId, token: token };
}

function scanCounts_(scheduleId, programId) {
  const tz = Session.getScriptTimeZone();
  const today = Utilities.formatDate(new Date(), tz, 'yyyy-MM-dd');
  const att = sheet_(SHEETS.ATTENDANCE.name).getDataRange().getValues();
    let present = 0, late = 0;
  const attendedIds = {};
  for (let i = 1; i < att.length; i++) {
    const r = att[i];
    if (r[2] !== scheduleId || !r[3]) continue;
    if (Utilities.formatDate(new Date(r[3]), tz, 'yyyy-MM-dd') !== today) continue;
    if (r[5] === 'Present') { present++; attendedIds[r[1]] = true; } else if (r[5] === 'Late') { late++; attendedIds[r[1]] = true; }
  }
  // Union ng roster + mga nag-attend na: kapag naubos ng scan ang huling session, hindi mawawala sa expected.
  const expectedIds = {};
  getSessionRecipients_(scheduleId, programId, new Date()).forEach(function (p) { expectedIds[p[0]] = true; });
  Object.keys(attendedIds).forEach(function (id) { expectedIds[id] = true; });
  const expected = Object.keys(expectedIds).length;
  return { total: Math.max(expected, present + late), present: present, late: late, unconfirmed: Math.max(0, expected - present - late) };
}

/** Today's sessions, straight from the Schedule sheet. */
function getScanSessions_(body) {
  if (!staffOk_(body.key)) return { success: false, error: 'Wrong or missing staff key.' };
  const tz = Session.getScriptTimeZone();
  const dayName = Utilities.formatDate(new Date(), tz, 'EEEE');

  const pd = sheet_(SHEETS.PROGRAMS.name).getDataRange().getValues();
  const names = {};
  for (let i = 1; i < pd.length; i++) names[pd[i][0]] = pd[i][1];

  const sched = sheet_(SHEETS.SCHEDULE.name).getDataRange().getValues();
  const sessions = [];
  for (let i = 1; i < sched.length; i++) {
    const r = sched[i];
    if (r[2] !== dayName) continue;
    sessions.push({
      scheduleId: r[0], programId: r[1], programName: names[r[1]] || r[1],
      start: fmtTime_(r[3]), end: fmtTime_(r[4]), venue: r[5],
      counts: scanCounts_(r[0], r[1])
    });
  }
  sessions.sort(function (a, b) { return a.start.localeCompare(b.start); });
  return { success: true, day: dayName, sessions: sessions };
}

/** lookup=1 → player info lang. Otherwise nire-record ang attendance at dini-deduct ang session. */
function handleScanPlayer_(body) {
  if (!staffOk_(body.key)) return { success: false, error: 'Wrong or missing staff key.' };

  const parsed = parseScanCode_(body.code);
  if (!parsed) return { success: false, error: 'Not a Livity QR.' };
  const manual = String(body.manual) === '1';
  if (!manual && parsed.token !== qrToken_(parsed.playerId)) return { success: false, error: 'Invalid or outdated QR.' };

  const row = findRowById_(SHEETS.PLAYERS.name, parsed.playerId);
  if (!row) return { success: false, error: 'Player not found.' };
  if (String(row[9] || 'Active').trim().toLowerCase() !== 'active') {
    return { success: false, error: 'This player is not active. Please check with Admin JA.' };
  }

  const infoOf = function () {
    return { playerId: row[0], fullName: row[1], category: row[3], guardianName: row[4], photoUrl: row[11] || '', programs: getPlayerRelationships_(row[0]) };
  };
  let info = infoOf();

  if (String(body.lookup) === '1') return { success: true, result: 'LOOKUP', player: info };

  const sched = findRowById_(SHEETS.SCHEDULE.name, body.scheduleId);
  if (!sched) return { success: false, error: 'Pick a session first.' };
  const programId = sched[1];

  const tz = Session.getScriptTimeZone();
  const now = new Date();
  const dateStr = Utilities.formatDate(now, tz, 'yyyy-MM-dd');

  const existing = findAttendanceRow_(info.playerId, sched[0], now);
  if (existing && (existing.attendanceStatus === 'Present' || existing.attendanceStatus === 'Late')) {
    try {
      sendNotification_('ADMIN_DUP_CHECKIN', { email: getConfigValue_('AdminEmail') }, { playerName: info.fullName, programName: sched[1] });
    } catch (e) { /* non-blocking */ }
    return { success: true, result: 'DUPLICATE', message: 'Already checked in', programId: programId, player: info, counts: scanCounts_(sched[0], programId) };
  }

  const startDate = Utilities.parseDate(dateStr + ' ' + fmtTime_(sched[3]), tz, 'yyyy-MM-dd HH:mm');
  const grace = Number(getConfigValue_('LateGraceMinutes')) || 10;
  const mins = Math.floor((now - startDate) / 60000);
  const isLate = mins > grace;
  const status = isLate ? 'Late' : 'Present';

  const inProgram = info.programs.some(function (p) { return p.programId === programId && p.state !== 'none'; });
  if (inProgram) registerForSession(info.playerId, sched[0]);
  if (!inProgram) {
    try {
      sendNotification_('ADMIN_UNREGISTERED_SCAN', { email: getConfigValue_('AdminEmail') }, { playerName: info.fullName, programName: sched[1] });
    } catch (e) { /* non-blocking */ }
  }

  const r = checkIn(info.playerId, sched[0], null, status, now);

  info = infoOf(); // refreshed sessions left
  const prog = info.programs.filter(function (p) { return p.programId === programId; })[0];
  let warn = '';
  if (r.registrationStatus === 'Walkin') warn = 'Not enrolled in this program — recorded as walk-in' + (r.walkInSurcharge ? ' (1.5× surcharge)' : '') + '.';
  else if (prog && prog.state === 'pending_payment') warn = 'Payment still pending.';
  else if (prog && (prog.state === 'expired' || prog.state === 'exhausted')) warn = 'Package ' + prog.state + ' — ask to top up.';

  logAudit_('SCAN_CHECKIN', info.playerId + ' — ' + status + ' (' + sched[0] + ')', null);
  return {
    success: true, result: isLate ? 'LATE' : 'PRESENT', minutesLate: isLate ? mins : 0,
    programId: programId, warn: warn, player: info, counts: scanCounts_(sched[0], programId)
  };
}
