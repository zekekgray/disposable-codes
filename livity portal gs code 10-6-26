/** Auto-marks Absent any REGISTERED-but-Unmarked player after their session ends — completes the sweep markAbsent_ was designed for.
 *  Guard: if NOBODY checked in for that session (likely cancelled / scanner not used), nobody is marked absent — admin is alerted instead. */
function runEndOfSessionSweep_(scheduleId, dateKey, programName, programId) {
  const tz = Session.getScriptTimeZone();
  const attData = sheet_(SHEETS.ATTENDANCE.name).getDataRange().getValues();
  const pending = [];
  let attended = 0;
  for (let i = 1; i < attData.length; i++) {
    const r = attData[i];
    if (r[2] !== scheduleId || !r[3]) continue;
    if (Utilities.formatDate(new Date(r[3]), tz, 'yyyy-MM-dd') !== dateKey) continue;
    if (r[5] === 'Present' || r[5] === 'Late') attended++;
    if (r[4] === 'Registered' && r[5] === 'Unmarked') pending.push(r);
  }
  if (pending.length === 0) return;

 if (attended === 0 && getAutoRegisterPrograms_().indexOf(programId) > -1) {
    sendNotification_('ADMIN_ATT_ANOMALY', { email: getConfigValue_('AdminEmail') }, { playerName: pending.length + ' player(s)', details: 'No check-ins were recorded for ' + programName + ' — session may have been cancelled or the scanner was not used. Nobody was auto-marked absent.' });
    logAudit_('END_OF_SESSION_SWEEP_SKIPPED', scheduleId + ' ' + dateKey + ' — 0 check-ins, ' + pending.length + ' left Unmarked', null);
    return;
  }

  pending.forEach(function (r) { markAbsent_(r[1], scheduleId, r[3]); });
  sendNotification_('ADMIN_ATT_ANOMALY', { email: getConfigValue_('AdminEmail') }, { playerName: pending.length + ' player(s)', details: 'Auto-marked absent after ' + programName + ' ended — no check-in recorded.' });
  logAudit_('END_OF_SESSION_SWEEP', scheduleId + ' ' + dateKey + ' — ' + pending.length + ' auto-marked absent', null);
}

/** Programs whose players are auto-registered before each session. Default: Academy only (Academy players are "automatically expected to attend").
 *  Regular/Advanced need a manual reserve, so they are NOT auto-registered unless admin adds them to Config → AutoRegisterPrograms (comma-separated PRG- codes). */
function getAutoRegisterPrograms_() {
  return String(getConfigValue_('AutoRegisterPrograms') || 'PRG-ACAD').split(',').map(function (x) { return x.trim(); }).filter(Boolean);
}

/** PlayerIDs with a usable (Active, not expired, sessions left) package in this program, Active players only. Reads each sheet once. */
function getAutoRegisterRosterIds_(programId) {
  const now = new Date();
  const pricing = sheet_(SHEETS.PRICING.name).getDataRange().getValues();
  const programOfPrice = {};
  for (let i = 1; i < pricing.length; i++) programOfPrice[pricing[i][0]] = pricing[i][1];

  const players = sheet_(SHEETS.PLAYERS.name).getDataRange().getValues();
  const activePlayers = {};
  for (let i = 1; i < players.length; i++) {
    if (String(players[i][9] || 'Active').trim().toLowerCase() === 'active') activePlayers[players[i][0]] = true;
  }

  const pkgs = sheet_(SHEETS.PACKAGES.name).getDataRange().getValues();
  const ids = {};
  for (let i = 1; i < pkgs.length; i++) {
    const r = pkgs[i];
    if (r[7] !== 'Active' || r[2] === 'PRC-MEMB') continue;
    if (programOfPrice[r[2]] !== programId) continue;
    if (r[6] && now > new Date(r[6])) continue;                  // expired
    if (Number(r[5]) >= Number(r[4])) continue;                  // no sessions left
    if (!activePlayers[r[1]]) continue;
    ids[r[1]] = true;
  }
  return Object.keys(ids);
}

/** Creates Registered/Unmarked Attendance rows for the expected roster of ONE session occurrence (batch write, idempotent).
 *  This is what makes a real no-show exist as a row, so runEndOfSessionSweep_ has something to mark Absent. */
function autoRegisterSessionRoster_(scheduleId, programId, startDt) {
  if (getAutoRegisterPrograms_().indexOf(programId) === -1) return 0;
  const tz = Session.getScriptTimeZone();
  const dateKey = Utilities.formatDate(startDt, tz, 'yyyy-MM-dd');
  const sheet = sheet_(SHEETS.ATTENDANCE.name);
  const data = sheet.getDataRange().getValues();

  const have = {};
  for (let i = 1; i < data.length; i++) {
    if (data[i][2] !== scheduleId || !data[i][3]) continue;
    have[data[i][1] + '|' + Utilities.formatDate(new Date(data[i][3]), tz, 'yyyy-MM-dd')] = true;
  }

  const base = Math.max(0, sheet.getLastRow() - 1);
  const rows = [];
  getAutoRegisterRosterIds_(programId).forEach(function (pid) {
    if (have[pid + '|' + dateKey]) return; // already registered or already scanned in
    rows.push(['ATT-' + Utilities.formatString('%04d', base + rows.length + 1), pid, scheduleId, startDt, 'Registered', 'Unmarked', '', false, false]);
  });
  if (rows.length) sheet.getRange(sheet.getLastRow() + 1, 1, rows.length, 9).setValues(rows);
  return rows.length;
}

/** Main ladder — run every 15 min. Fires each rung once per session occurrence, channel controlled per TypeKey. */
function runReminderLadder_() {
  const tz = Session.getScriptTimeZone();
  const now = new Date();
  const WINDOW_MIN = 20; // must exceed the trigger interval so no gap; audit marker prevents double-fire
  const REGISTER_HOURS_BEFORE = Number(getConfigValue_('AutoRegisterHoursBefore')) || 2; // roster is pre-registered this many hours before start

  const schedData = sheet_(SHEETS.SCHEDULE.name).getDataRange().getValues();
  const programsData = sheet_(SHEETS.PROGRAMS.name).getDataRange().getValues();
  const programNames = {};
  for (let i = 1; i < programsData.length; i++) programNames[programsData[i][0]] = programsData[i][1];
  const playersData = sheet_(SHEETS.PLAYERS.name).getDataRange().getValues();

  for (let s = 1; s < schedData.length; s++) {
    const row = schedData[s];
    const scheduleId = row[0], programId = row[1], dayName = row[2];
    const startTimeStr = fmtTime_(row[3]), endTimeStr = fmtTime_(row[4]);
    const venue = row[5];
    const programName = programNames[programId] || programId;

    const occurrences = scheduleOccurrencesWithin_(dayName, startTimeStr, 8);

    occurrences.forEach(function (startDt) {
      const dateKey = Utilities.formatDate(startDt, tz, 'yyyy-MM-dd');
      const sessionLabel = Utilities.formatDate(startDt, tz, 'EEEE, MMM d h:mm a');

      REMINDER_LADDER_RUNGS.forEach(function (rung) {
        const fireAt = new Date(startDt.getTime() - rung.hours * 3600000);
        const diffMin = (now - fireAt) / 60000;
        if (diffMin < 0 || diffMin > WINDOW_MIN) return;

        const marker = 'LADDER_' + rung.key + '_' + scheduleId + '_' + dateKey;
        if (hasAuditAction_(marker)) return;

        getSessionRecipients_(scheduleId, programId, startDt).forEach(function (pr) {
          sendNotification_(rung.key, { id: pr[0], email: pr[6] }, {
            playerName: pr[1], programName: programName, sessionDate: sessionLabel, venue: venue
          });
        });
        logAudit_(marker, rung.key + ' sent for ' + scheduleId + ' on ' + dateKey, null);
      });

      // Session ends — admin summary + attendance sweep (fires once, ~20-min window after EndTime)
      const dateStr = Utilities.formatDate(startDt, tz, 'yyyy-MM-dd');
      const endDt = Utilities.parseDate(dateStr + ' ' + endTimeStr, tz, 'yyyy-MM-dd HH:mm');
      // Pre-register the expected roster (once per occurrence) so a no-show exists as Registered/Unmarked for the sweep below.
      // Not a narrow window on purpose: if a trigger run is missed, the next run inside [start-Nh, end) still registers.
      if (now >= new Date(startDt.getTime() - REGISTER_HOURS_BEFORE * 3600000) && now < endDt) {
        const regMarker = 'LADDER_REGISTER_' + scheduleId + '_' + dateKey;
        if (!hasAuditAction_(regMarker)) {
          const n = autoRegisterSessionRoster_(scheduleId, programId, startDt);
          logAudit_(regMarker, 'Roster pre-registered for ' + scheduleId + ' on ' + dateKey + ' — ' + n + ' player(s)', null);
        }
      }

      const endDiffMin = (now - endDt) / 60000;
      if (endDiffMin >= 0 && endDiffMin <= WINDOW_MIN) {
        const endMarker = 'LADDER_END_' + scheduleId + '_' + dateKey;
        if (!hasAuditAction_(endMarker)) {
          const counts = scanCounts_(scheduleId, programId);
          sendNotification_('SCHED_SESSION_ENDING', { email: getConfigValue_('AdminEmail') }, { programName: programName, present: counts.present, unconfirmed: counts.unconfirmed });
          logAudit_(endMarker, 'Session ending notice sent for ' + scheduleId + ' on ' + dateKey, null);
        }
      }

      // Attendance confirmation sweep — 30 min after end, once
      const sweepDiffMin = (now - new Date(endDt.getTime() + 30 * 60000)) / 60000;
      if (sweepDiffMin >= 0 && sweepDiffMin <= WINDOW_MIN) {
        const sweepMarker = 'LADDER_SWEEP_' + scheduleId + '_' + dateKey;
        if (!hasAuditAction_(sweepMarker)) {
          runEndOfSessionSweep_(scheduleId, dateKey, programName, programId);
          logAudit_(sweepMarker, 'Attendance sweep run for ' + scheduleId + ' on ' + dateKey, null);
        }
      }
    });
  }
}

function runReminderLadderSafe_() {
  try { runReminderLadder_(); }
  catch (err) { logAudit_('SYS_GAS_ERROR', 'Reminder ladder failed: ' + err, null); notifySystem_('SYS_GAS_ERROR', 'Reminder ladder failed: ' + err); }
}

