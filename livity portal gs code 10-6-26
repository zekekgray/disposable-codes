/** Active packages for a player, with sessions remaining computed. */
function getPlayerActivePackages_(playerId) {
  const pkgData = sheet_(SHEETS.PACKAGES.name).getDataRange().getValues();
  const packages = [];
  for (let i = 1; i < pkgData.length; i++) {
    const row = pkgData[i];
    if (row[1] !== playerId || row[7] !== 'Active') continue;
    const priceRow = findRowById_(SHEETS.PRICING.name, row[2]);
    const sessionsTotal = Number(row[4]), sessionsUsed = Number(row[5]);
    packages.push({
      packageId: row[0],
      priceId: row[2],
      programId: priceRow ? priceRow[1] : '',
      packageType: priceRow ? priceRow[3] : '',
      sessionsTotal: sessionsTotal,
      sessionsUsed: sessionsUsed,
      remaining: sessionsTotal - sessionsUsed,
      expiryDate: row[6] ? new Date(row[6]).toISOString() : ''
    });
  }
  return packages;
}

/**
 * One player, many training relationships. Aggregates ALL programs a player has ever
 * bought a package in (skipping the one-time Membership Fee row, which isn't a training
 * relationship on its own) — this is what lets "Miguel Santos" show Academy + Regular + Private
 * as separate lines under one identity, instead of one program per player record.
 */
function getPlayerRelationships_(playerId) {
  const programsData = sheet_(SHEETS.PROGRAMS.name).getDataRange().getValues();
  const programNames = {};
  for (let i = 1; i < programsData.length; i++) programNames[programsData[i][0]] = programsData[i][1];

  // Every programId the player has EVER purchased a package in (any status) — not just Active,
  // so an exhausted/expired-but-not-flipped-to-Completed package still surfaces its real state.
  const pkgData = sheet_(SHEETS.PACKAGES.name).getDataRange().getValues();
  const programIds = {};
  for (let i = 1; i < pkgData.length; i++) {
    const row = pkgData[i];
    if (row[1] !== playerId || row[2] === 'PRC-MEMB') continue;
    const priceRow = findRowById_(SHEETS.PRICING.name, row[2]);
    if (priceRow) programIds[priceRow[1]] = true;
  }

  // Private Training has no fixed-price package row — surface it anyway so it's not silently dropped.
  const playerRow = findRowById_(SHEETS.PLAYERS.name, playerId);
  if (playerRow && playerRow[7]) programIds[playerRow[7]] = true;

  return Object.keys(programIds).map(function (pid) {
    const s = computeProgramState_(playerId, pid);
    return {
      programId: pid,
      programName: programNames[pid] || pid,
      remaining: s.remaining,
      total: s.total || 0,
      hasPackage: s.state !== 'none',
      state: s.state,
      expiryDate: s.expiryDate
    };
  });
}

/** Existing-player purchase (top-up/renewal): resolves the PriceID server-side by program, never trusts a client price. */
function handleTopup_(body) {
  const playerId = body.playerId;
  const programId = body.programId;
  const category = body.category || '';
  const packageKey = body.packageKey || '';
  const paymentMethod = body.paymentMethod || 'Unspecified';

  if (!playerId || !programId) {
    return { success: false, error: 'Missing playerId or programId.' };
  }

  const playerRow = findRowById_(SHEETS.PLAYERS.name, playerId);
  if (!playerRow) {
    return { success: false, error: 'Player not found.' };
  }

 let priceId = resolveTopupPriceId_(programId, category, packageKey);
  if (programId === 'PRG-REG' && packageKey !== 'single' && !playerHasRemainingSessions_(playerId, programId)) {
    priceId = ({ 'U5-U7':'PRC-U57', 'U9-U13':'PRC-U913', 'U15+':'PRC-U15' })[category] || null;
  }
  if (!priceId) {
    return { success: false, error: "This isn't available to purchase online yet — please WhatsApp Admin JA." };
  }

  const priceCheck_ = findRowById_(SHEETS.PRICING.name, priceId);
  if (!priceCheck_ || !(Number(priceCheck_[5]) > 0)) {
    return { success: false, error: "This isn't available to purchase online yet — please WhatsApp Admin JA." };
  }

  let packageId;
  try {
    packageId = purchasePackage(playerId, priceId); // Top-Up type enforces "must have remaining sessions"; new Academy packages don't need that check
  } catch (err) {
    return { success: false, error: err.message };
  }

  const pricingRow = findRowById_(SHEETS.PRICING.name, priceId);
  let amount = Number(pricingRow[5]);
  if (programId === 'PRG-ACAD' && !playerHasMembership_(playerId)) {
    purchasePackage(playerId, 'PRC-MEMB');
    amount += membershipFee_();
  }
  // === START: PAYMENT STATE — SUBMISSIONS START PENDING, NOT PAID ===
  const paymentId = recordPayment(playerId, packageId, amount, paymentMethod, 'Pending');
  // === END: PAYMENT STATE ===

  logAudit_('WEB_TOPUP', playerId + ' purchased via web — ' + priceId, null);

  const playerName = playerRow[1], guardianName = playerRow[4], guardianEmail = playerRow[6];

  sendNotification_('PAY_SUBMITTED', { id: playerId, email: guardianEmail }, {
    amount: amount, playerName: playerName
  });
  sendNotification_('ADMIN_NEW_PAYMENT', { email: getConfigValue_('AdminEmail') }, {
    guardianName: guardianName, amount: amount
  });

  return { success: true, packageId: packageId, paymentId: paymentId, amountDue: amount };
}

/**
 * Adds a NEW training relationship to an EXISTING player — reuses their LVT ID and on-file
 * guardian/consent info entirely. Never creates a new Players row. Blocks re-adding a program
 * the player is already in (that's what Top-Up/renewal is for, not this).
 */
function handleAddProgram_(body) {
  const playerId = body.playerId;
  const programId = body.programId;
  const category = body.category || '';
  const packageKey = body.packageKey || '';
  const paymentMethod = body.paymentMethod || 'Unspecified';

  if (!playerId || !programId) {
    return { success: false, error: 'Missing playerId or programId.' };
  }

  const playerRow = findRowById_(SHEETS.PLAYERS.name, playerId);
  if (!playerRow) {
    return { success: false, error: 'Player not found.' };
  }

  const alreadyIn = getPlayerRelationships_(playerId).some(function (r) { return r.programId === programId; });
  if (alreadyIn) {
    return { success: false, error: 'This player is already in that program — use Top Up instead.' };
  }

  const priceId = resolvePriceId_(programId, packageKey, category);
  let pricingRow = null, packageId = null, totalPrice = 0;

  if (priceId) {
    pricingRow = findRowById_(SHEETS.PRICING.name, priceId);
    if (!pricingRow) return { success: false, error: 'Unknown PriceID resolved: ' + priceId };
    packageId = purchasePackage(playerId, priceId);
    totalPrice = Number(pricingRow[5]);
  }
  if (!priceId && programId !== 'PRG-PRIV') {
    return { success: false, error: 'Could not resolve a valid package for this program/category.' };
  }

  if (programId === 'PRG-ACAD') {
    if (!playerHasMembership_(playerId)) {
      purchasePackage(playerId, 'PRC-MEMB');
      totalPrice += membershipFee_();
    }
  }
  if (programId === 'PRG-PRIV') purchasePackage(playerId, 'PRC-PRIV'); // 0 sessions, ₱0 — para may record ang relationship

  // === START: PAYMENT STATE — SUBMISSIONS START PENDING, NOT PAID ===
 const paymentId = totalPrice > 0 ? recordPayment(playerId, packageId || 'PENDING', totalPrice, paymentMethod, 'Pending') : null;
  // === END: PAYMENT STATE ===
 logAudit_('WEB_ADD_PROGRAM', playerId + ' added ' + programId + ' via web', null);
  if (category && !playerRow[3]) {
    const ps = sheet_(SHEETS.PLAYERS.name), pd = ps.getDataRange().getValues();
    for (let i = 1; i < pd.length; i++) if (pd[i][0] === playerId) { ps.getRange(i + 1, 4).setValue(category); break; }
  }

  const playerName = playerRow[1], guardianName = playerRow[4], guardianEmail = playerRow[6];

  sendNotification_('ENROLL_SUBMITTED', { id: playerId, email: guardianEmail }, {
    guardianName: guardianName, playerName: playerName, programName: lbProgramLabelServer_(programId)
  });
  sendNotification_('ADMIN_NEW_ENROLLMENT', { email: getConfigValue_('AdminEmail') }, {
    playerName: playerName, programName: lbProgramLabelServer_(programId)
  });

  return { success: true, packageId: packageId, paymentId: paymentId, amountDue: totalPrice };
}

