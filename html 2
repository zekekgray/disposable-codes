<script>
const header=document.getElementById('header');
window.addEventListener('scroll',()=>header.classList.toggle('scrolled',scrollY>20),{passive:true});
const obs=new IntersectionObserver(es=>es.forEach(e=>{if(e.isIntersecting)e.target.classList.add('show')}),{threshold:.12});
document.querySelectorAll('.reveal').forEach(x=>obs.observe(x));

const data={
 "ArtiPlay":["ArtiPlay","A specialized operating environment for sports academies, designed around active players, coaches, staff, training and academy operations."],
 "ArtiStock":["ArtiStock","An inventory and operations system centered on locations, inventory volume, transactions, SKUs and users."],
 "ArtiSnack":["ArtiSnack","A food and retail POS environment centered on terminals, locations, transactions and active users."],
 "BHT":["Business Health Toolkit","A business intelligence layer for connected sources, reporting, analytics and operating signals."],
 "VEX AI":["VEX AI","An AI automation product measured around AI actions, documents processed and records analyzed."],
 "Portfolio":["Portfolio","A broader ArtiByte portfolio including OWLBOUND, ArtiCare, ArtiStage and ArtiWork."]
};
document.querySelectorAll('.product-card').forEach(card=>{
 card.addEventListener('click',()=>{
  document.querySelectorAll('.product-card').forEach(c=>c.classList.remove('active'));card.classList.add('active');
  const d=data[card.dataset.name]||data.Portfolio;
  document.getElementById('detailName').textContent=d[0];
  document.getElementById('detailText').textContent=d[1];
  document.getElementById('detail').scrollIntoView({behavior:'smooth',block:'center'});
 });
});
</script>
