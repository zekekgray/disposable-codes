<style>
:root{
 --bg:#05070b;--bg2:#080c13;--surface:#0c111a;--surface2:#101722;--line:rgba(255,255,255,.09);
 --text:#f7f9fc;--muted:#9aa6b5;--dim:#687484;--blue:#1683ff;--cyan:#55c8ff;--violet:#7567ff;
