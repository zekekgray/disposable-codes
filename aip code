<section class="hero">
  <svg class="hero-motif" viewBox="0 0 200 200" xmlns="http://www.w3.org/2000/svg">
    <rect x="20" y="20" width="160" height="160" rx="18" fill="none" stroke="var(--line-dark2)" stroke-width="1"/>
