<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>A private note from ArtiBytte — Independent Partners</title>
<meta name="robots" content="noindex, nofollow">
<meta name="description" content="A private invitation to join the Independent ArtiBytte Partners network.">
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='192 200 640 640'%3E%3Crect x='192' y='200' width='640' height='640' fill='%23142850'/%3E%3Ccircle cx='505' cy='432' r='185' fill='white'/%3E%3Ccircle cx='697' cy='433' r='75' fill='%23142850'/%3E%3Crect x='240' y='660' width='463' height='50' fill='white'/%3E%3Crect x='240' y='745' width='545' height='50' fill='white'/%3E%3C/svg%3E">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300;0,9..144,340;0,9..144,440;0,9..144,560;0,9..144,650;1,9..144,440;1,9..144,500&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
:root{
  --obsidian:#0b0c0f;
  --graphite:#15171b;
  --graphite2:#1c1f24;
  --ivory:#f6f2ea;
  --ink:#17150f;
  --ink2:#55503f;
  --bronze:#c78a4d;
  --bronze-light:#e3b27f;
  --bronze-micro:#e6b988;
  --bronze-deep:#8a5a2b;
  --mist:#9298a3;
  --mist2:#c7cbd1;
  --line-dark:rgba(255,255,255,.09);
  --line-dark2:rgba(255,255,255,.16);
  --line-light:rgba(23,21,15,.13);
  --line-light2:rgba(23,21,15,.24);
  --serif:'Fraunces',Georgia,serif;
  --sans:'Inter',-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;

  --space-section:96px;
  --space-section-mobile:64px;
  --space-section-lg:120px;
  --space-section-lg-mobile:76px;
  --radius-card:14px;
  --radius-tight:9px;
  --radius-pill:999px;
}
*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth;overflow-x:hidden}
@media (prefers-reduced-motion:reduce){html{scroll-behavior:auto}*{animation-duration:.001ms!important;transition-duration:.001ms!important}}
body{background:var(--obsidian);color:var(--mist2);font-family:var(--sans);font-size:16px;line-height:1.6;-webkit-font-smoothing:antialiased;overflow-x:hidden}
@media(max-width:768px){body{font-size:15px}}
::selection{background:var(--bronze);color:#0b0c0f}
a{color:inherit;text-decoration:none}
img,svg{display:block;max-width:100%}
.wrap{max-width:900px;margin:0 auto;padding:0 32px}
@media(max-width:640px){.wrap{padding:0 22px}}

/* one focus language for the whole system */
a:focus-visible,button:focus-visible,[tabindex]:focus-visible{outline:2px solid var(--bronze-light);outline-offset:3px;border-radius:4px}

/* one hover language for every card in the system */
.hover-lift{transition:transform .25s cubic-bezier(.22,.9,.32,1),border-color .25s ease,background-color .25s ease}
.hover-lift:hover{transform:translateY(-3px)}

/* recurring system-tag — echoes the hero's IAP / 01 marker across every section */
.section-tag{display:inline-flex;align-items:center;gap:7px;font-family:var(--sans);font-size:10.5px;letter-spacing:.16em;text-transform:uppercase;color:var(--mist);font-weight:600;margin-bottom:14px}
.section-tag .dot{width:3.5px;height:3.5px;border-radius:50%;background:var(--bronze-micro);flex:none}
.light .section-tag{color:var(--ink2)}

.grain{position:fixed;inset:0;pointer-events:none;z-index:999;opacity:.035;mix-blend-mode:overlay}

/* minimal top bar — mobile only, desktop uses sidebar */
.topbar{padding:28px 0 0}
.topbar .brand{display:flex;align-items:center;gap:10px;font-family:var(--serif);font-size:17px;letter-spacing:.2px;font-weight:560;color:#f0ede6}
.brand-mark{width:24px;height:24px;border-radius:6px;flex:none;background:linear-gradient(160deg,var(--bronze-light),var(--bronze-deep));transition:transform .35s cubic-bezier(.22,.9,.32,1)}
.sidebar-brand:hover .brand-mark{transform:rotate(-8deg) scale(1.08)}
.private-tag{display:inline-block;margin-left:12px;font-size:11px;letter-spacing:.1em;text-transform:uppercase;color:var(--bronze-light);border:1px solid var(--line-dark2);border-radius:999px;padding:4px 10px;font-family:var(--sans);font-weight:600}

section{position:relative}
.light{background:var(--ivory);color:var(--ink)}
.light .mist2{color:var(--ink2)}
.pad{padding:var(--space-section) 0}
@media(max-width:640px){.pad{padding:var(--space-section-mobile) 0}}
.head{max-width:620px;margin-bottom:52px}
.head h2{font-family:var(--serif);font-weight:440;letter-spacing:-.8px;font-size:clamp(24px,3.6vw,36px);line-height:1.2}
.light .head h2{color:var(--ink)}
:not(.light) .head h2{color:#f6f4ef}
.head p{margin-top:16px;font-size:16px;line-height:1.65;color:var(--mist2)}
.light .head p{color:var(--ink2)}
@media(max-width:768px){.head{margin-bottom:38px}.head p{font-size:15px}}

/* hero */
.hero{padding:96px 0 64px;position:relative;overflow:hidden}
.hero::before{content:"";position:absolute;inset:0;z-index:-1;background:radial-gradient(1100px 640px at 88% -18%,rgba(199,138,77,.13),transparent 58%),radial-gradient(500px 320px at 6% 30%,rgba(199,138,77,.05),transparent 70%)}
.hero-motif{position:absolute;top:-40px;right:-40px;width:260px;height:260px;opacity:.5;pointer-events:none;z-index:-1}
@media(max-width:760px){.hero-motif{width:170px;height:170px;top:-20px;right:-20px}}
.sys-id{display:inline-flex;align-items:center;gap:8px;font-family:var(--sans);font-size:11px;letter-spacing:.18em;text-transform:uppercase;color:var(--mist);font-weight:600;margin-bottom:22px}
.sys-id .dot{width:4px;height:4px;border-radius:50%;background:var(--bronze-micro)}
.hero-mark{display:flex;align-items:baseline;gap:18px;margin-bottom:34px}
.hero-mark .iap-big{font-family:var(--serif);font-weight:650;font-size:clamp(64px,12vw,140px);line-height:.85;letter-spacing:-3px;background:linear-gradient(160deg,var(--bronze-light),var(--bronze-deep));-webkit-background-clip:text;background-clip:text;color:transparent;display:inline-block;transition:transform .4s cubic-bezier(.22,.9,.32,1)}
.hero-mark:hover .iap-big{transform:translateY(-2px) scale(1.015)}
.hero-mark .iap-sub{font-size:12.5px;letter-spacing:.14em;text-transform:uppercase;color:var(--mist);line-height:1.6;max-width:150px;border-left:1px solid var(--line-dark2);padding-left:16px}
.hero h1{font-family:var(--serif);font-weight:440;letter-spacing:-1px;font-size:clamp(24px,3.4vw,36px);line-height:1.16;color:#f6f4ef;max-width:640px;margin-top:6px}
.hero .lede{margin-top:18px;font-size:15.5px;line-height:1.65;color:var(--mist2);max-width:520px}
@media(max-width:560px){.hero{padding:72px 0 48px}.hero-mark{gap:12px}.hero-mark .iap-sub{padding-left:12px}}

/* story / pull */
.story{display:grid;grid-template-columns:1.1fr .9fr;gap:52px;align-items:start}
@media(max-width:760px){.story{grid-template-columns:1fr;gap:30px}}
.story .body p{font-size:16px;line-height:1.75;color:var(--ink2)}
.story .body p + p{margin-top:16px}
.pull{border-left:2px solid var(--bronze);padding-left:24px}
.pull p{font-family:var(--serif);font-style:italic;font-size:20px;line-height:1.5;color:var(--ink)}
.pull span{display:block;margin-top:12px;font-family:var(--sans);font-style:normal;font-size:12.5px;color:var(--ink2)}

/* pillars — recurring-concept strip under Overview */
.pillars{display:grid;grid-template-columns:repeat(3,1fr);gap:0;margin-top:52px;border-top:1px solid var(--line-dark)}
@media(max-width:680px){.pillars{grid-template-columns:1fr}}
.pillar{padding:24px 20px 4px;border-right:1px solid var(--line-dark)}
.pillar:last-child{border-right:none}
@media(max-width:680px){.pillar{border-right:none;border-bottom:1px solid var(--line-dark);padding:20px 0}.pillar:last-child{border-bottom:none}}
.pillar .pillar-num{font-family:var(--serif);font-style:italic;font-size:12px;color:var(--bronze-light);display:block;margin-bottom:8px}
.pillar h4{font-family:var(--serif);font-weight:500;font-size:16px;color:#f5f2ec;margin-bottom:6px;letter-spacing:-.1px}
.pillar p{font-size:13px;color:var(--mist2);line-height:1.6}

/* tracks */
.iap-tracks{display:flex;flex-direction:column}
.iap-track{display:grid;grid-template-columns:56px 1fr 1.3fr;gap:28px;padding:28px 0;border-top:1px solid var(--line-dark);align-items:baseline}
.iap-tracks .iap-track:last-child{border-bottom:1px solid var(--line-dark)}
.iap-track .idx{font-family:var(--serif);font-style:italic;font-size:14px;color:var(--bronze-light);align-self:start;padding-top:4px}
.iap-track h3{font-family:var(--serif);font-weight:440;font-size:19px;color:#f5f2ec;letter-spacing:-.2px;line-height:1.25}
.iap-track p{font-size:14px;color:var(--mist2);line-height:1.65;max-width:440px}
@media(max-width:680px){.iap-track{grid-template-columns:1fr;gap:6px}.iap-track .idx{display:none}}

/* tiers — connected path, visual centerpiece */
#tiers.pad{padding:var(--space-section-lg) 0;position:relative}
#tiers::before{content:"";position:absolute;inset:0;z-index:-1;background:radial-gradient(760px 460px at 12% 20%,rgba(199,138,77,.07),transparent 65%)}
.tier-path{display:flex;flex-direction:column;position:relative}
.tier-node{display:grid;grid-template-columns:64px 1fr;column-gap:28px;position:relative;padding-bottom:44px}
.tier-node:last-child{padding-bottom:0}
.tier-node-rail{position:relative;display:flex;flex-direction:column;align-items:center}
.tier-node-circle{width:56px;height:56px;border-radius:50%;background:var(--graphite);border:1.5px solid var(--bronze);display:flex;align-items:center;justify-content:center;font-family:var(--serif);font-style:italic;font-weight:600;font-size:17px;color:var(--bronze-light);flex:none;z-index:2;box-shadow:0 0 0 6px var(--obsidian)}
.tier-node-line{position:absolute;top:56px;bottom:-44px;width:2px;background:linear-gradient(var(--bronze),var(--line-dark2));z-index:1}
.tier-node-body{padding-top:8px}
.tier-node-body .tier-label{display:block;font-family:var(--serif);font-style:italic;font-weight:600;font-size:15px;letter-spacing:.02em;color:var(--bronze-micro);margin-bottom:10px}
.tier-node-body h3{font-family:var(--serif);font-weight:500;font-size:clamp(20px,2.6vw,26px);color:#f5f2ec;letter-spacing:-.3px;line-height:1.2;margin-bottom:8px}
.tier-node-body p{font-size:14.5px;color:var(--mist2);line-height:1.7;max-width:460px}
@media(max-width:560px){
  #tiers.pad{padding:var(--space-section-lg-mobile) 0}
  .tier-node{grid-template-columns:48px 1fr;column-gap:18px;padding-bottom:34px}
  .tier-node-circle{width:44px;height:44px;font-size:14px}
  .tier-node-line{top:44px;bottom:-34px}
}
.tier-branch-label{display:flex;align-items:center;gap:14px;margin:56px 0 24px;color:var(--mist);font-size:11.5px;text-transform:uppercase;letter-spacing:.14em;font-weight:600}
.tier-branch-label::after{content:"";flex:1;height:1px;background:var(--line-dark)}
.tier-x-card{border:1px dashed var(--line-dark2);border-radius:var(--radius-card);background:var(--graphite);padding:30px 32px;display:grid;grid-template-columns:64px 1fr;column-gap:28px;align-items:start;transition:border-color .25s ease,transform .25s cubic-bezier(.22,.9,.32,1)}
.tier-x-card:hover{border-color:var(--bronze-light);transform:translateY(-3px)}
.tier-x-card .tier-node-circle{border-style:dashed;border-color:var(--line-dark2);color:var(--mist);box-shadow:none}
.tier-x-card h3{font-family:var(--serif);font-weight:500;font-size:20px;color:#f5f2ec;margin-bottom:8px}
.tier-x-card p{font-size:14px;color:var(--mist2);line-height:1.65;max-width:460px}
@media(max-width:560px){.tier-x-card{grid-template-columns:44px 1fr;column-gap:18px;padding:24px 22px}}

/* categories — editorial bordered grid, echoes .comp-grid; no icons */
.cat-grid{display:grid;grid-template-columns:repeat(4,1fr);border-top:1px solid var(--line-dark);border-left:1px solid var(--line-dark)}
@media(max-width:760px){.cat-grid{grid-template-columns:repeat(2,1fr)}}
@media(max-width:480px){.cat-grid{grid-template-columns:1fr}}
.cat-cell{border-right:1px solid var(--line-dark);border-bottom:1px solid var(--line-dark);padding:30px 26px;transition:background-color .25s ease}
.cat-cell:hover{background:rgba(255,255,255,.02)}
.cat-cell .idx{display:block;font-family:var(--serif);font-style:italic;font-size:13px;color:var(--bronze-micro);margin-bottom:14px}
.cat-cell h3{font-family:var(--serif);font-weight:500;font-size:17px;color:#f5f2ec;margin-bottom:8px;letter-spacing:-.1px}
.cat-cell .cat-desc{font-size:13px;color:var(--mist2);line-height:1.6;margin-bottom:16px}
.cat-cell .cat-list{font-size:12px;color:var(--mist);line-height:1.7;letter-spacing:.01em}
@media(max-width:480px){.cat-cell{padding:24px 22px}}
.cat-link{margin-top:22px;font-size:13px;color:var(--mist);line-height:1.7;text-align:center;max-width:520px;margin-left:auto;margin-right:auto}
.cat-link em{font-style:italic;color:var(--mist2)}

/* compensation — transparent, two-row system */
.comp-guarantee{display:flex;align-items:flex-start;gap:14px;background:rgba(23,21,15,.045);border-radius:var(--radius-card);padding:18px 20px;margin-bottom:36px;max-width:640px}
.comp-guarantee .check{flex:none;width:22px;height:22px;border-radius:50%;background:var(--bronze-deep);color:#fff;display:flex;align-items:center;justify-content:center;font-size:12px;font-weight:700;margin-top:1px}
.comp-guarantee p{font-size:13.5px;color:var(--ink);line-height:1.6;font-weight:500}
.comp-section-label{font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:var(--bronze-deep);font-weight:700;margin-bottom:14px}
.comp-row{margin-bottom:32px}
.comp-row:last-child{margin-bottom:0}
.comp-pair{display:grid;grid-template-columns:1fr 1fr;gap:16px}
@media(max-width:680px){.comp-pair{grid-template-columns:1fr}}
.comp-cell-v2{border-radius:var(--radius-card);padding:26px 24px;transition:transform .25s cubic-bezier(.22,.9,.32,1)}
.comp-cell-v2:hover{transform:translateY(-3px)}
.comp-cell-v2 .letter{font-family:var(--serif);font-style:italic;font-size:13px;display:block;margin-bottom:12px}
.comp-cell-v2 h4{font-family:var(--serif);font-weight:500;font-size:18px;margin-bottom:9px;letter-spacing:-.2px}
.comp-cell-v2 p{font-size:13.5px;line-height:1.6}
.comp-cell-work{background:#fff;border:1px solid var(--line-light2)}
.comp-cell-work .letter{color:var(--bronze-deep)}
.comp-cell-work h4{color:var(--ink)}
.comp-cell-work p{color:var(--ink2)}
.comp-cell-outcome{background:var(--ink);border:1px solid var(--ink)}
.comp-cell-outcome .letter{color:var(--bronze-light)}
.comp-cell-outcome h4{color:#f6f2ea}
.comp-cell-outcome p{color:#cfc9ba}
.comp-cell-outcome.comp-cell-strategic{border:1px solid var(--bronze-deep)}
.written-cue{display:flex;align-items:center;gap:6px;font-size:11.5px;color:var(--bronze-light);margin-top:14px}
.best-when{display:inline-block;font-size:11px;letter-spacing:.04em;color:var(--bronze-light);font-weight:600;margin-top:14px;padding-top:14px;border-top:1px solid rgba(255,255,255,.08)}
.comp-cell-work .best-when{color:var(--bronze-deep);border-top-color:var(--line-light2)}
.comp-note{margin-top:20px;font-size:13px;color:var(--ink2);line-height:1.7;max-width:560px}
:not(.light) .comp-note{color:var(--mist2)}

/* steps */
.iap-steps{display:flex;flex-direction:column}
.iap-step{display:grid;grid-template-columns:100px 1fr;column-gap:32px;align-items:start;padding:30px 0;border-top:1px solid var(--line-dark)}
.iap-steps .iap-step:last-child{border-bottom:1px solid var(--line-dark)}
.iap-step .num{font-size:11.5px;font-weight:500;letter-spacing:.16em;color:#f0ede6;opacity:.45;padding:8px 0 0}
.iap-step h4{font-family:var(--serif);font-weight:500;color:#f5f2ec;font-size:clamp(18px,2vw,22px);line-height:1.2;letter-spacing:-.01em;margin:0 0 8px;max-width:460px}
.iap-step p{font-size:14px;line-height:1.65;color:var(--mist2);opacity:.78;max-width:480px;margin:0}
@media(max-width:680px){.iap-step{grid-template-columns:1fr;row-gap:10px;padding:24px 0}.iap-step .num{padding-top:0}}

/* structure — org & reusable infra */
.infra-tree{margin-top:32px;max-width:420px}
.infra-root{font-family:var(--sans);font-size:13px;font-weight:700;letter-spacing:.04em;color:var(--ink);margin-bottom:10px}
.infra-tree ul{list-style:none;display:flex;flex-direction:column;gap:6px;border-left:1px solid var(--line-light2);margin-left:6px;padding-left:16px}
.infra-tree li{font-size:13px;color:var(--ink2);line-height:1.4;position:relative}
.infra-tree li::before{content:"";position:absolute;left:-16px;top:9px;width:10px;height:1px;background:var(--line-light2)}
.ceiling-block{margin-top:44px;padding:24px 26px;border-radius:var(--radius-card);background:rgba(23,21,15,.035);max-width:600px}
.ceiling-block .cb-label{font-size:11px;letter-spacing:.1em;text-transform:uppercase;color:var(--bronze-deep);font-weight:700;margin-bottom:12px}
.ceiling-block p{font-size:13.5px;color:var(--ink2);line-height:1.65}
.ceiling-list{margin-top:10px;display:flex;flex-wrap:wrap;gap:6px}
.ceiling-list span{font-size:11.5px;color:var(--ink2);padding:5px 10px;border:1px solid var(--line-light2);border-radius:var(--radius-pill)}
.core-network{margin-top:44px;display:grid;grid-template-columns:1fr 1fr;gap:0;border-top:1px solid var(--line-dark);border-left:1px solid var(--line-dark);max-width:640px}
@media(max-width:600px){.core-network{grid-template-columns:1fr}}
.core-cell{border-right:1px solid var(--line-dark);border-bottom:1px solid var(--line-dark);padding:24px 22px}
.core-cell h4{font-family:var(--serif);font-weight:500;font-size:16px;color:#f5f2ec;margin-bottom:6px}
.core-cell .core-meta{font-size:11.5px;color:var(--bronze-light);letter-spacing:.04em;margin-bottom:12px}
.core-cell ul{list-style:none;display:flex;flex-direction:column;gap:5px}
.core-cell li{font-size:12.5px;color:var(--mist2);line-height:1.5}
.mental-model{margin-top:44px;padding:28px 30px;border-left:2px solid var(--bronze);max-width:640px}
.mental-model .mm-old{font-size:13px;color:var(--mist);text-decoration:line-through;text-decoration-color:rgba(255,255,255,.3);margin-bottom:14px}
.mental-model .mm-new{font-family:var(--serif);font-style:italic;font-size:17px;line-height:1.55;color:#f5f2ec}
.mental-model .mm-caveat{margin-top:14px;font-size:12.5px;color:var(--mist2);line-height:1.6}
.org-diagram-v2{display:flex;flex-direction:column;align-items:center;margin:48px 0 8px}
.org-node{font-family:var(--sans);font-size:13px;font-weight:600;color:#f5f2ec;background:var(--graphite);border:1px solid var(--line-dark2);border-radius:10px;padding:10px 18px;text-align:center}
.org-node.emphasis{font-family:var(--serif);font-size:16px;font-style:italic;color:var(--bronze-light);background:transparent;border:none;padding:0}
.org-node.partner{border-color:var(--bronze-deep);color:var(--bronze-light);margin-top:8px}
.org-line{width:1px;height:26px;background:var(--line-dark2)}
.org-hbar{width:100%;max-width:460px;height:1px;background:var(--line-dark2);margin-top:14px}
.org-products{display:flex;justify-content:space-between;width:100%;max-width:460px;margin-top:0}
.org-branch{display:flex;flex-direction:column;align-items:center;flex:1}
.org-shared{margin-top:28px;font-size:13px;color:var(--mist2);line-height:1.6;max-width:480px;text-align:center}
.org-split{display:flex;gap:0;width:100%;max-width:520px;justify-content:space-between;margin-top:10px}
@media(max-width:600px){.org-split{flex-direction:column;align-items:center;gap:28px}}
.org-split-branch{display:flex;flex-direction:column;align-items:center;flex:1}
.org-split-branch .org-node{font-size:12px}
.org-split-branch .org-sub{margin-top:8px;font-size:11px;color:var(--mist);text-align:center;letter-spacing:.02em}
.org-merge-line{width:1px;height:26px;background:linear-gradient(var(--line-dark2),var(--bronze))}

/* good fit list */
.fit-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(220px,100%),1fr));gap:16px}
.fit-card{background:var(--graphite);border-radius:var(--radius-card);padding:22px 22px}
.fit-card h3{font-family:var(--serif);font-size:16.5px;font-weight:500;color:#f5f2ec;margin-bottom:8px;letter-spacing:-.1px}
